# Copiá este archivo a .env (no se versiona) y completá los valores.

# --- MongoDB ---
# URI sin credenciales (recomendado) o con ellas.
MONGO_URI=mongodb+srv://cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Usuario de BD con permisos limitados (rol readWrite SOLO sobre haxball_minijuegos y haxball_test).
# Se crea en Atlas: Database Access > Add New Database User. Si están, pisan las credenciales de MONGO_URI.
MONGO_USER=bot_haxball
MONGO_PASSWORD=
# Opcional: forzar el nombre de la base. En TEST_MODE se usa haxball_test por defecto.
# MONGO_DB_NAME=haxball_minijuegos

# --- HaxBall / Discord (alternativa a secrets.json) ---
# HAXBALL_TOKEN=thr1.xxxxx
# DISCORD_WEBHOOK_CALLADMIN=
# DISCORD_WEBHOOK_REPORTES=
# DISCORD_WEBHOOK_TOKENS=
# DISCORD_WEBHOOK_CHATLOG=
# DISCORD_WEBHOOK_REPLAYS=
# DISCORD_WEBHOOK_STATS=
# DISCORD_WEBHOOK_BUGS=
# DISCORD_WEBHOOK_MODS=

# --- Otros ---
# HEADLESS=true
# PANEL_PORT=3000
